{
  "manifest_version": 3,
  "name": "PassRotate - Universal Password Expiry & Breach Guard",
  "version": "1.0.0",
  "description": "Universal password rotation, 30-day expiry enforcement, 5-day breach warnings, and HIBP dark web leak detection for any website.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PassRotate Security Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "dashboard/dashboard.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/crypto.js", "utils/hibp.js", "content/content-script.js"],
      "css": ["content/content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "content/content-styles.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
